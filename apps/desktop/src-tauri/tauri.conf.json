{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "净值雷达",
  "version": "0.1.0",
  "identifier": "com.local.netvalueradar",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -w @found/frontend",
    "beforeBuildCommand": "npm run build -w @found/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "净值雷达",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/LckAndLove/found/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NkVCNDU2RENCQkM5NkYKUldSdnlidmNWclJ1cGRBaEM5YzExamZxWjhUQjYzQ0w1SVV1OGFuUXVUWU4zOU1WOUFlS1dUN3QK"
    }
  }
}
