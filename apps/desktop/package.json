{
  "name": "@found/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "3.found macOS 桌面应用",
  "author": "milo",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package:mac": "electron-builder --config electron-builder.config.cjs --mac dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.10"
  }
}
